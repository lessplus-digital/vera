# Copiar a .env (git-ignored). En el VPS, estas variables van en el .env junto al docker-compose.

PORT=3000
LOG_LEVEL=info

# WhatsApp Cloud API (Meta)
WA_VERIFY_TOKEN=          # el mismo "Verify token" que se pone en Meta → WhatsApp → Configuración
WA_APP_SECRET=            # Meta → App → Configuración → Básica → "Clave secreta de la app" (firma X-Hub-Signature-256)
WA_ACCESS_TOKEN=          # token de sistema con permiso whatsapp_business_messaging
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v25.0

# graph = envía de verdad por Meta · fake = solo registra (desarrollo sin WhatsApp)
WA_MODO=graph

# Milisegundos que se espera por más mensajes del mismo cliente antes de responder
BUFFER_MS=3000

# Supabase. La URL es la misma del dashboard (VITE_SUPABASE_URL).
# La clave es SECRETA (sb_secret_…): Supabase → Project Settings → API Keys →
# Secret keys → crear una nueva llamada "bot-node". Nunca en el dashboard ni en git.
# Sin estas dos el bot arranca igual, pero sin dedupe persistente ni log de turnos.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
