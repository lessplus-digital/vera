{
  "name": "plateo-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor del bot de WhatsApp de Plateo (reemplaza el workflow de n8n)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx --env-file-if-exists=.env scripts/sim.ts",
    "chat": "tsx --env-file-if-exists=.env scripts/chat.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.11",
    "openai": "^7.25.0",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
