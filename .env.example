# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se sube a git.

# Supabase — https://supabase.com/dashboard/project/<tu-proyecto>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WhatsApp Business API — https://developers.facebook.com/
VITE_WA_PHONE_NUMBER_ID=
VITE_WA_API_VERSION=v25.0
VITE_WA_ACCESS_TOKEN=
# Fase 7 (bot Node): con esta variable los envíos pasan por el servidor del bot
# (POST {url}/api/wa con el JWT de la sesión) y VITE_WA_ACCESS_TOKEN ya no hace
# falta: en el corte se configura esta y se BORRA la del token. Ej: https://bot.plateo.cloud
VITE_WA_PROXY_URL=
